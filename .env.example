# Required for generating feedback from the DeepSeek API (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=

# Optional: override the DeepSeek model (default: deepseek-chat) or point at another OpenAI-compatible endpoint
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=

# Required for audio transcription (Whisper on Groq, free tier) (https://console.groq.com/keys)
GROQ_API_KEY=

# Optional: override the transcription model (default: whisper-large-v3-turbo) or endpoint (default: https://api.groq.com/openai/v1)
TRANSCRIBE_MODEL=
TRANSCRIBE_BASE_URL=

# Optional: enables the content moderation check on transcripts (OpenAI moderation endpoint). Skipped when unset. (https://platform.openai.com/account/api-keys)
OPENAI_API_KEY=

# Optional: for rate-limiting the demo app (https://demo.useliftoff.com/) using Upstash (https://upstash.com/blog/upstash-ratelimit)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
